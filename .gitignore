# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated)
mono_crash.*

# Mono auto generated files
mono_crash.*

# Build results
[Bb]in/
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ww][Ii][Nn]/
[Aa][Cc][Tt][Ii][Vv][Ee][Cc][Oo][Nn][Ff][Ii][Gg]/
.vs/

# Rider
.idea/
.idea/*

# React and Node.js specific
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# Ignore folder for local environment settings
.env.local
.env.development.local
.env.test.local
.env.production.local

# Others
.DS_Store
Thumbs.db

# Build and Obj directories to be ignored
MyBackendProject/bin/
MyBackendProject/obj/

# Ignore specific file types in any location
*.AssemblyInfo.cs
*.AssemblyInfoInputs.cache
*.exe
*.dll
*.pdb
*.apphost.exe
/MyBackendProject/obj
/MyBackendProject/obj
/MyBackendProject/obj/Debug
/MyBackendProject/obj/Debug/net8.0
/MyBackendProject/obj/Debug/net8.0/ref
MyBackendProject/obj/Debug/net8.0/MyBackendProject.pdb
MyBackendProject/obj/Debug/net8.0/ref/MyBackendProject.dll
