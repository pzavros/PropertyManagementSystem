# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono auto generated files
mono_crash.*

# Build results
[Bb]in/
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ww][Ii][Nn]/
[Aa][Cc][Tt][Ii][Vv][Ee][Cc][Oo][Nn][Ff][Ii][Gg]/
.vs/

# Rider specific
.idea/
.idea/*

# React and Node.js specific
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# Ignore folder for local environment settings
.env.local
.env.development.local
.env.test.local
.env.production.local

# Others
.DS_Store
Thumbs.db

# Build and Obj directories to be ignored
**/bin/
**/obj/

# Ignore specific file types in any location
*.AssemblyInfo.cs
*.AssemblyInfoInputs.cache
*.exe
*.dll
*.pdb
*.apphost.exe

# Ignore Rider project-specific files
*.idea/
*.idea/*

# Ignore temporary project files
**/obj/**/*.csproj.nuget.dgspec.json
**/obj/**/*.json
**/obj/**/*.nuget.cache
**/obj/**/*.nuget.info
**/obj/**/*.nuget.spec.json

# Ignore all changes to project-specific debug outputs
**/obj/Debug/
