# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (Mono Auto Generated)
mono_crash.*

# Mono auto generated files
mono_crash.*

# Build results
[Bb]in/
[Dd]ebug*/
[Rr]elease*/
[Xx]64/
[Xx]86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ww][Ii][Nn]/
[Aa][Cc][Tt][Ii][Vv][Ee][Cc][Oo][Nn][Ff][Ii][Gg]/
.vs/

# Rider
.idea/
.idea/*

# React and Node.js specific
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# Ignore folder for local environment settings
.env.local
.env.development.local
.env.test.local
.env.production.local

# Others
.DS_Store
Thumbs.db

# Specific files and directories to ignore based on your image
MyBackendProject/bin/
MyBackendProject/obj/
MyBackendProject/*.AssemblyInfo.cs
MyBackendProject/*.nuget.dgspec.json
MyBackendProject/*.nuget.g.props
MyBackendProject/*.assets.json
MyBackendProject/*.nuget.cache
MyBackendProject/*.packagespec.json
MyBackendProject/*.model.nuget.info
MyBackendProject/*.restore.info
